# remnawave-monitoring — настройки стека. Скопируйте в .env (chmod 600) и заполните.
# Мастер scripts/install.sh делает это сам.

# --- Панель (для экспортёра) ---
PANEL_URL=https://panel.example.com
PANEL_TOKEN=
SCRAPE_SECONDS=30
# Какие ноды считать мостами (label role=bridge): тег ноды в панели, регулярка по имени, список стран.
BRIDGE_TAG=bridge
BRIDGE_REGEX=(?i)bridge
BRIDGE_COUNTRIES=
# 1 — не проверять TLS-сертификат панели (самоподписанный)
PANEL_INSECURE=0

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
# Слушать: 0.0.0.0 — снаружи (вход по паролю), 127.0.0.1 — только через ssh -L 3000:127.0.0.1:3000
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000
# Внешний адрес Grafana для ссылок в уведомлениях, например http://203.0.113.5:3000
GRAFANA_ROOT_URL=

# --- Telegram для тревог Grafana (пусто — без Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Проверки HTTPS (blackbox, Kuma): страница подписки; панель проверяется всегда ---
SUB_URL=

# --- Uptime Kuma ---
KUMA_BIND=0.0.0.0
KUMA_PORT=3001

# --- Prometheus ---
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d

# --- Версии образов (latest — обновляется при docker compose pull) ---
PROMETHEUS_IMAGE_TAG=latest
GRAFANA_IMAGE_TAG=latest
NODE_EXPORTER_IMAGE_TAG=latest
BLACKBOX_IMAGE_TAG=latest
KUMA_IMAGE_TAG=2
PYTHON_IMAGE_TAG=3.12-slim
